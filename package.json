{
  "name": "nexa-sports-nutrition",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @nexa/web dev",
    "build": "pnpm --filter @nexa/db generate && pnpm --filter @nexa/web build",
    "start": "pnpm --filter @nexa/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @nexa/db generate",
    "db:migrate": "pnpm --filter @nexa/db migrate",
    "db:push": "pnpm --filter @nexa/db push",
    "db:seed": "pnpm --filter @nexa/db seed",
    "db:studio": "pnpm --filter @nexa/db studio",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:reset": "docker compose -f infra/docker/docker-compose.yml down -v"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
