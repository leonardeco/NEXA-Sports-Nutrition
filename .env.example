# ──────────────────────────────────────────────────────────────────────────
#  NEXA Sports Nutrition — plantilla de entorno
#  Copiar a .env y rellenar. NUNCA commitear .env (constitución, principio 7).
# ──────────────────────────────────────────────────────────────────────────

# ─── Base de datos ────────────────────────────────────────────────────────
# Local (Docker Compose): postgresql://nexa:nexa@localhost:5432/nexa
# Neon: usar la cadena con pooling para DATABASE_URL y la directa para DIRECT_URL
DATABASE_URL="postgresql://nexa:nexa@localhost:5432/nexa?schema=public"
DIRECT_URL="postgresql://nexa:nexa@localhost:5432/nexa?schema=public"

# ─── Aplicación ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Carrito y órdenes (F2) ───────────────────────────────────────────────
# Tarifa plana de envío nacional, en centavos. 1200000 = $12.000.
NEXA_SHIPPING_FLAT_CENTS="1200000"

# Panel de administración. Mínimo 32 caracteres: por debajo, la sesión no se
# emite y el panel queda inaccesible a propósito.
#   Generar:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Alta:     pnpm db:admin correo@ejemplo.com "una contraseña larga"
ADMIN_SESSION_SECRET=""

# Secreto del cron que libera las reservas vencidas (RF-09). Se envía como
# `Authorization: Bearer <secreto>` a POST /api/cron/expire-orders.
CRON_SECRET=""

# ─── Wompi (ADR-0003) ─────────────────────────────────────────────────────
# Sin estas cuatro variables el botón de pago no se renderiza y la tienda
# sigue funcionando con WhatsApp (RNF-03). Se sacan del dashboard de Wompi.
#
# El webhook se configura allí apuntando a:
#   https://<tu-dominio>/api/webhooks/wompi
#
# Sandbox: https://sandbox.wompi.co/v1 · Producción: https://production.wompi.co/v1
WOMPI_API_URL="https://sandbox.wompi.co/v1"
# Única clave expuesta al navegador
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=""
# Solo servidor — jamás con prefijo NEXT_PUBLIC_
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""

# ─── Asistente de ventas (ADR-0005) ───────────────────────────────────────
ANTHROPIC_API_KEY=""
NEXA_BOT_MODEL="claude-sonnet-5"

# ─── Contacto ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="573226993891"
NEXT_PUBLIC_CONTACT_EMAIL="leonardecojt@gmail.com"
